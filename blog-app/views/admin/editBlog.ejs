<%- include("../layout/adminHeader") %>

    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
        <div>
            <h2 class="text-3xl font-bold text-dark">
                Edit Blog
            </h2>
            <p class="text-gray-500 mt-1">Update your blog post</p>
        </div>
        <a href="/admin/blogs"
            class="mt-4 md:mt-0 inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors text-sm font-medium">
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Blogs
        </a>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">

        <div class="p-6 md:p-8">

            <form action="/update-blog/<%= blog._id %>" method="POST" class="space-y-6">

                <!-- Title -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-heading mr-2 text-primary"></i>Blog Title
                    </label>
                    <input type="text" name="title" value="<%= blog.title %>" required placeholder="Enter blog title..."
                        class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-blue-100 transition-all" />
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-align-left mr-2 text-primary"></i>Description
                    </label>
                    <textarea name="description" required placeholder="Write your blog content here..." rows="8"
                        class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-blue-100 transition-all resize-none"><%= blog.description %></textarea>
                </div>

                <!-- Current Image -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-image mr-2 text-primary"></i>Current Cover Image
                    </label>
                    <div class="w-full max-w-xs">
                        <img src="/uploads/<%= blog.image %>" alt="Current cover"
                            class="w-full h-48 object-cover rounded-lg border border-gray-200" />
                        <p class="text-xs text-gray-400 mt-2">To change the image, go to All Blogs and delete this blog,
                            then create a new one.</p>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="flex items-center justify-end pt-4">
                    <a href="/admin/blogs"
                        class="mr-4 px-6 py-3 border border-gray-200 text-gray-600 rounded-lg hover:bg-gray-50 transition-colors font-medium">
                        Cancel
                    </a>
                    <button type="submit"
                        class="px-8 py-3 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors font-semibold shadow-lg shadow-green-500/30">
                        <i class="fas fa-save mr-2"></i>
                        Update Blog
                    </button>
                </div>

            </form>

        </div>

    </div>

    <%- include("../layout/adminFooter") %>