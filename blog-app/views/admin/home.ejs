<%- include("../layout/siteHeader") %>

    <!-- Section Header -->
    <div class="flex items-center justify-between mb-10" id="blogs">
        <div>
            <h2 class="text-3xl font-bold text-dark">
                Latest Blogs
            </h2>
            <p class="text-gray-500 mt-1">Fresh from our blog</p>
        </div>
    </div>

    <!-- Blog Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

        <% if (blogs.length===0) { %>
            <div class="col-span-full text-center py-16">
                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-blog text-4xl text-gray-300"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-600 mb-2">No blogs yet</h3>
                <p class="text-gray-400">Check back later for new content!</p>
            </div>
            <% } %>

                <% blogs.forEach((blog, index)=> { %>

                    <article class="card-hover bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">

                        <!-- Image -->
                        <div class="relative h-52 overflow-hidden">
                            <img src="/uploads/<%= blog.image %>" alt="<%= blog.title %>"
                                class="w-full h-full object-cover" />
                        </div>

                        <!-- Content -->
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-dark mb-3 line-clamp-2">
                                <%= blog.title %>
                            </h3>

                            <p class="text-gray-500 mb-4 line-clamp-3 text-sm">
                                <%= blog.description.substring(0, 120) %>...
                            </p>

                            <a href="/blog/<%= blog._id %>"
                                class="inline-flex items-center text-primary font-semibold hover:text-blue-700 transition-colors group">
                                Read Full Article
                                <i
                                    class="fas fa-arrow-right ml-2 transform group-hover:translate-x-1 transition-transform"></i>
                            </a>
                        </div>

                    </article>

                    <% }) %>

    </div>

    <!-- Empty State -->
    <% if (blogs.length===0) { %>
        <div class="text-center mt-12">
            <a href="/admin/dashboard"
                class="inline-flex items-center px-6 py-3 bg-primary text-white rounded-lg font-medium hover:bg-blue-600 transition-all">
                <i class="fas fa-plus mr-2"></i>
                Create First Blog
            </a>
        </div>
        <% } %>

            <%- include("../layout/siteFooter") %>