<%- include("../layout/adminHeader") %>

    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
        <div>
            <h2 class="text-3xl font-bold text-dark">
                All Blogs
            </h2>
            <p class="text-gray-500 mt-1">Manage your blog posts</p>
        </div>
        <a href="/admin/add-blog"
            class="mt-4 md:mt-0 inline-flex items-center px-4 py-2 bg-primary text-white rounded-lg hover:bg-blue-600 transition-colors text-sm font-medium">
            <i class="fas fa-plus mr-2"></i>
            Add New Blog
        </a>
    </div>

    <!-- Blogs Table Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">

        <% if (blogs.length===0) { %>
            <div class="p-12 text-center">
                <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-blog text-3xl text-gray-300"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-600 mb-2">No blogs yet</h3>
                <p class="text-gray-400 mb-4">Create your first blog post to get started!</p>
                <a href="/admin/add-blog"
                    class="inline-flex items-center px-4 py-2 bg-primary text-white rounded-lg hover:bg-blue-600 transition-colors">
                    <i class="fas fa-plus mr-2"></i>
                    Create Blog
                </a>
            </div>
            <% } else { %>

                <!-- Table -->
                <div class="overflow-x-auto">
                    <table class="w-full">

                        <thead class="bg-gray-50 border-b border-gray-100">
                            <tr>
                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    <i class="fas fa-image mr-2"></i>Image
                                </th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    <i class="fas fa-heading mr-2"></i>Title
                                </th>

                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    <i class="fas fa-cogs mr-2"></i>Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-gray-100">

                            <% blogs.forEach(blog=> { %>

                                <tr class="hover:bg-gray-50 transition-colors">

                                    <!-- Image -->
                                    <td class="px-6 py-4">
                                        <img src="/uploads/<%= blog.image %>" alt="<%= blog.title %>"
                                            class="h-16 w-24 object-cover rounded-lg shadow-sm" />
                                    </td>

                                    <!-- Title -->
                                    <td class="px-6 py-4">
                                        <p class="text-sm font-semibold text-dark line-clamp-1">
                                            <%= blog.title %>
                                        </p>
                                        <p class="text-xs text-gray-400 mt-1 line-clamp-2">
                                            <%= blog.description.substring(0, 80) %>...
                                        </p>
                                    </td>

                                    <!-- Actions -->
                                    <td class="px-6 py-4">
                                        <div class="flex items-center space-x-2">
                                            <a href="/edit-blog/<%= blog._id %>"
                                                class="inline-flex items-center px-3 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition-colors text-sm font-medium">
                                                <i class="fas fa-edit mr-1.5"></i>
                                                Edit
                                            </a>
                                            <a href="/delete-blog/<%= blog._id %>"
                                                onclick="return confirm('Are you sure you want to delete this blog?')"
                                                class="inline-flex items-center px-3 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm font-medium">
                                                <i class="fas fa-trash mr-1.5"></i>
                                                Delete
                                            </a>
                                        </div>
                                    </td>

                                </tr>

                                <% }) %>

                        </tbody>

                    </table>
                </div>

                <!-- Table Footer -->
                <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
                    <p class="text-sm text-gray-500">
                        Showing <span class="font-semibold">
                            <%= blogs.length %>
                        </span> blog<%= blogs.length !==1 ? 's' : '' %>
                    </p>
                </div>

                <% } %>

    </div>

    <%- include("../layout/adminFooter") %>