<%- include("../layouts/header") %>

    <div class="max-w-md mx-auto bg-white p-6 rounded shadow-lg">
        <h2 class="text-2xl font-bold mb-6 text-center">Admin Login</h2>

        <form action="/admin/login" method="POST">

            <input type="email" name="email" placeholder="Enter Email" class="w-full border p-2 mb-4 rounded" required>

            <input type="password" name="password" placeholder="Enter Password" class="w-full border p-2 mb-4 rounded"
                required>

            <button class="w-full bg-blue-500 text-white py-2 rounded hover:bg-blue-600">
                Login
            </button>

        </form>

        <p class="text-center mt-4">
            Don't have account?
            <a href="/admin/register" class="text-blue-500">Register</a>
        </p>
    </div>

    <%- include("../layouts/footer") %>