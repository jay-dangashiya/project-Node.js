<%- include("../layouts/header") %>

    <div class="max-w-md mx-auto bg-white p-6 rounded shadow-lg">
        <h2 class="text-2xl font-bold mb-6 text-center">Admin Register</h2>

        <form action="/admin/register" method="POST">

            <input type="text" name="name" placeholder="Enter Name" class="w-full border p-2 mb-4 rounded" required>

            <input type="email" name="email" placeholder="Enter Email" class="w-full border p-2 mb-4 rounded" required>

            <input type="password" name="password" placeholder="Enter Password" class="w-full border p-2 mb-4 rounded"
                required>

            <button class="w-full bg-green-500 text-white py-2 rounded hover:bg-green-600">
                Register
            </button>

        </form>

        <p class="text-center mt-4">
            Already have account?
            <a href="/admin/login" class="text-blue-500">Login</a>
        </p>
    </div>

    <%- include("../layouts/footer") %>