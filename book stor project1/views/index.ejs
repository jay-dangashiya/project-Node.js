<!DOCTYPE html>
<html>
<head>
  <title>Book Store</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #fff9c4, #ffe082);
      text-align: center;
    }

    h1 {
      margin: 30px;
      font-size: 40px;
      color: #333;
    }

    .book-container {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 25px;
      padding: 20px;
    }

    .card {
      width: 230px;
      background: #fffde7;
      border-radius: 15px;
      padding: 15px;
      box-shadow: 0 6px 15px rgba(0,0,0,0.2);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-10px);
    }

    .card img {
      width: 100%;
      height: 280px;
      object-fit: cover;
      border-radius: 10px;
    }

    .card h2 {
      font-size: 18px;
      margin: 10px 0 5px;
    }

    .card p {
      color: #555;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <h1>📚 Book Store</h1>

  <div class="book-container">
    <% books.forEach(book => { %>
      <div class="card">
        <img src="<%= book.image %>" alt="book" />
        <h2><%= book.title %></h2>
        <p>Author: <%= book.author %></p>
      </div>
    <% }) %>
  </div>

</body>
</html>