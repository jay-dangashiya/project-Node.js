<%- include("partials/navbar") %>

<h2>All Products</h2>

<% if(products.length === 0){ %>
  <p>No products found</p>
<% } %>

<% products.forEach(p => { %>
  <div style="border:1px solid #ccc;padding:10px;margin:10px;">
    <h3><%= p.name %></h3>
    <p>Price: ₹<%= p.price %></p>
    <p>Owner: <%= p.user?.username %></p>
    <p>Category: <%= p.category?.name %></p>
  </div>
<% }) %>
